PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/studymate
JWT_SECRET=your_jwt_secret_key_change_me_in_production

# AI Provider Keys
# Add one or both. The app will default to Gemini if both are provided.
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# Cloudinary Integration (Optional)
# If left blank, uploads will be stored locally in the server's uploads/ folder.
CLOUDINARY_URL=
